BOT_TOKEN=
ADMIN_PASSWORD=

# Optional but recommended in production: comma-separated Telegram user IDs.
ADMIN_USER_IDS=

# Optional. Directory where bot.db will be created.
# DB_DIR=.

# Optional. Directory with *_extra.json files.
# EXTRA_DATA_DIR=data

# Optional. 0 — always send the schedule in the classic view (plain messages).
# RICH_SCHEDULE=1
